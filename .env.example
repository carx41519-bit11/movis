# Set these privately in your hosting dashboard, not in GitHub.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
MOVIS_ADMIN_USERNAME=admin
MOVIS_ADMIN_PASSWORD=CHOOSE_A_NEW_PRIVATE_PASSWORD
MOVIS_MODE=demo
MOVIS_SEED_DEMO=1
MOVIS_HTTPS_HOSTING=1
# For tested warehouse YOLO inference on suitably sized hosting:
# MOVIS_MODE=yolo
# MOVIS_WEIGHTS=/path/to/your/warehouse-best.pt
